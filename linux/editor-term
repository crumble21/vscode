#!/usr/bin/env bash
# Launch VSCodium or VS Code and land in the terminal panel (Hyprland).
#
#   editor-term [codium|code] [args…]
#
# The first argument picks the editor; without it, codium is used if installed, else code.
# Remaining arguments pass through to the editor.
#
# Neither editor has an "open terminal on startup" setting, so: start it, wait for the new
# window to take focus, then press the chord bound to workbench.action.terminal.focus
# in keybindings.json. That command is idempotent, so pressing it a few times while the
# workbench finishes loading is harmless.

case "${1:-}" in
    codium|code) editor="$1"; shift ;;
    *) editor="$(command -v codium >/dev/null && echo codium || echo code)" ;;
esac
# Window classes on Wayland: codium -> "codium", code -> "com.microsoft.VSCode" (or "code").
classes='^(codium|VSCodium|code|com\.microsoft\.VSCode)$'

windows() { hyprctl clients -j | jq -r --arg re "$classes" '[.[] | select(.class | test($re)) | .address] | join(" ")'; }
active()  { hyprctl activewindow -j | jq -r --arg re "$classes" 'select(.class | test($re)) | .address'; }

before=$(windows)
"$editor" "$@" &

press() {
    hyprctl eval 'hl.dispatch(hl.dsp.send_key_state({ mods = "CTRL ALT SHIFT", key = "F12", state = "down" }))' >/dev/null
    hyprctl eval 'hl.dispatch(hl.dsp.send_key_state({ mods = "CTRL ALT SHIFT", key = "F12", state = "up" }))' >/dev/null
}

for _ in $(seq 1 60); do   # wait up to ~15s for a new window
    sleep 0.25
    addr=$(active)
    if [[ -n "$addr" && " $before " != *" $addr "* ]]; then
        for _ in 1 2 3 4 5 6; do
            # stop if the user has moved focus elsewhere
            [[ "$(hyprctl activewindow -j | jq -r .address)" == "$addr" ]] || exit 0
            press
            sleep 0.5
        done
        exit 0
    fi
done
